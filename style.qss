* { color: $txt; }
QMainWindow, *[bg=true] { background-color: $bg; }
#card {
    background-color: $cardbg;
    border-radius: 8px;
}
#cardcont { background-color: $cardbg; }
#transpbg { background: transparent; }

#curtxt {
    color: $txt;
    background-color: $ctbg;
    padding: 8px;
    border-radius: 12px;
}

IcoButton, QPushButton {
    color: $txt;
    padding: 4px;
    border-width: 2px;
    border-radius: 12px;
}

*[thm=primary] {
    color: $invtxt;
    background-color: $primary;
    border-color: $primary;
}
*[thm=primary]:pressed {
    background-color: $primarydown;
}
*[thm=secondary] {
    background-color: $secondary;
    border-color: $secondary;
}
*[thm=secondary]:pressed {
    background-color: $seconddown;
}
*[thm=tertiary] {
    background-color: $tertiary;
    border-color: $tertiary;
}
*[thm=tertiary]:pressed {
    background-color: $tertiarydown;
}
*[thm=neutral] {
    background-color: $neutral;
    border-color: $neutral;
}
*[thm=neutral]:pressed {
    background-color: $neutraldown;
}
*[btnsty=round] {
    border-radius: 18px;
}
*[btnsty=big] {
    padding: 10px 18px;
    border-radius: 16px;
}

#confirmButtons QPushButton {
    padding: 4px 8px;
}

Spoiler QToolButton {
    background-color: #A0C4B5;
    border-radius: 4px;
    padding: 5px;
    border-style: outset;
    border-width: 2px;
    border-radius: 6px;
    border-color: #588D77;
    qproperty-lineColour: #555;
    qproperty-lineWidth: 3px;
}
Spoiler QToolButton:pressed {
    background-color: #72A791;
    border-style: inset;
}
Spoiler #contentArea {
    background-color: #D7E6DF;
    border-style: solid;
    border-width: 2px;
    border-radius: 5px;
    border-color: #B2CDBA;
}

TaskBubble { background: transparent; }
TaskBubble QLabel {
    border-style: outset;
    border-width: 2px;
    border-color: #666;
}
TaskBubble[pressed=true] QLabel { border-style: inset; }
TaskBubble QLabel[bubble=top] {
    background-color: #DD8866;
    border-top-left-radius: 12px;
    padding: 8px; padding-bottom: 4px;
    border-bottom: 0px;
    border-right: 0px;
}
TaskBubble[pressed=true] QLabel[bubble=top] { background-color: #BB6655; }
TaskBubble QLabel[bubble=bot] {
    background-color: #CC66AA;
    border-bottom-left-radius: 12px;
    padding: 8px; padding-top: 4px;
    border-top: 0px;
    border-right: 0px;
}
TaskBubble[pressed=true] QLabel[bubble=bot] { background-color: #AA4488; }
QPushButton[bubblebtn=true] {
    background-color: $fadecardbg;
    border-width: 2px;
    border-radius: 0;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    border-left: 0px;
    padding: 8px; padding-top: 4px;
}

QTextEdit, QLineEdit {
    background-color: $cardbg;
    border-style: solid;
    border-width: 2px;
    border-color: #888;
    border-radius: 6px;
    padding: 4px;
}
QTextEdit:focus, QLineEdit:focus {
    border-color: #555;
}
QLineEdit { border-radius: 12px; }

QScrollBar {
    background: transparent;
    border: none;
}
QScrollBar:vertical {
    width: 6px;
    margin: 2px 0px 2px 0px;
}
QScrollBar:horizontal {
    height: 6px;
    margin: 0px 2px 0px 2px;
}
QScrollBar::handle {
    background: rgba(0, 0, 0, 90);
    border-radius: 3px;
    min-height: 24px;
}
QScrollBar::add-line, QScrollBar::sub-line {
    width: 0px; height: 0px;
    background: none;
}

QSlider, QSlider::groove {
    border: none;
    background: #E2E4E9;
    border-radius: 3px;
    margin: 0px;
}
QSlider:horizontal { height: 24px; }
QSlider:vertical { width: 24px; }
QSlider::groove:horizontal { height: 18px; }
QSlider::groove:vertical { width: 18px; }

QSlider::sub-page { border-radius: 3px; }
QSlider::sub-page:horizontal, QSlider::add-page:vertical { background: #4F8EF7; }

QSlider::handle {
    background: $cardbg;
    border: 2px solid #3B6FD1;
    border-radius: 6px;
    width: 16px;
    height: 16px;
}

QWidget#navigation {
    background-color: $cardbg;
    padding: 6px 4px;
    border-bottom: 2px solid #EEF0F3;
}

QWidget#navigation QPushButton {
    color: #3B82F6;
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 4px 10px;
    margin: 2px;
    font-weight: 600;
}
QWidget#navigation QPushButton:hover {
    background-color: #E8F0FE;
}
QWidget#navigation QPushButton:pressed {
    background-color: #D2E3FC;
}

/* Get rid of a yucky line */
QCalendarWidget QAbstractItemView:enabled {
    outline: 0;
    gridline-color: transparent;
    selection-background-color: transparent;
    selection-color: transparent;
}
